{
  "name": "pi-sec-review",
  "displayName": "pi-sec-review",
  "description": "Review workspace changes with a configurable local or remote Copilot skill.",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pi-sec-review.runReview",
        "title": "Run Workspace Review",
        "category": "PI Security Review",
        "icon": "$(play)"
      },
      {
        "command": "pi-sec-review.selectSkill",
        "title": "Select Local Skill",
        "category": "PI Security Review",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pi-sec-review.selectRemoteSkill",
        "title": "Select Remote Skill",
        "category": "PI Security Review",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pi-sec-review.openLastResult",
        "title": "Open Last Review Result",
        "category": "PI Security Review"
      }
    ],
    "submenus": [
      {
        "id": "piSecReview.context",
        "label": "PI Security Review"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi-sec-review",
          "title": "PI Security Review",
          "icon": "resources/shield.svg"
        }
      ]
    },
    "views": {
      "pi-sec-review": [
        {
          "id": "piSecReview.view",
          "name": "Workspace Review"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pi-sec-review.runReview",
          "when": "view == piSecReview.view",
          "group": "navigation@1"
        },
        {
          "command": "pi-sec-review.selectSkill",
          "when": "view == piSecReview.view",
          "group": "navigation@2"
        },
        {
          "command": "pi-sec-review.selectRemoteSkill",
          "when": "view == piSecReview.view",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "submenu": "piSecReview.context",
          "group": "piSecReview@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "piSecReview.context",
          "group": "piSecReview@1"
        }
      ],
      "piSecReview.context": [
        {
          "command": "pi-sec-review.runReview",
          "group": "1_review@1"
        },
        {
          "command": "pi-sec-review.selectSkill",
          "group": "2_configuration@1"
        },
        {
          "command": "pi-sec-review.selectRemoteSkill",
          "group": "2_configuration@2"
        }
      ]
    },
    "configuration": {
      "title": "PI Security Review",
      "properties": {
        "piSecReview.skillPath": {
          "type": "string",
          "default": ".github/skills/security-baseline-review/SKILL.md",
          "scope": "resource",
          "description": "Path to the local SKILL.md file. Relative paths are resolved from the workspace folder."
        },
        "piSecReview.remoteSkillUrl": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "HTTPS URL of a remote SKILL.md. When set, it takes precedence over the local skill path and is cached locally."
        },
        "piSecReview.maxDiffCharacters": {
          "type": "number",
          "default": 120000,
          "minimum": 10000,
          "maximum": 500000,
          "scope": "resource",
          "description": "Maximum number of Git change characters sent to the language model."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
