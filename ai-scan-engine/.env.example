DOCKER_LIBRARY=public.ecr.aws/docker/library
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
QUEUE_PROTOCOL=rabbitmq
QUEUE_BROKER_URL=amqp://ai_scan:replace-with-a-rabbitmq-password@10.240.66.53:5672/
RABBITMQ_QUEUES=security.scan.lite,security.scan.standard,security.scan.release

# Kafka 模式下设置 QUEUE_PROTOCOL=kafka，并配置以下变量。
KAFKA_BROKERS=host.docker.internal:9092
KAFKA_TOPICS=security.scan.lite,security.scan.standard,security.scan.release
KAFKA_GROUP_ID=ai-scan-engine

PLATFORM_BASE_URL=http://host.docker.internal:8081
PLATFORM_ADMIN_TOKEN=replace-with-a-long-random-token
ENGINE_WORK_ROOT=/var/lib/ai-scan-engine/work
ENGINE_DATABASE_PATH=/var/lib/ai-scan-engine/engine.db
MAX_FILE_BYTES=1048576
MAX_CONCURRENCY=2
CALLBACK_TIMEOUT_SECONDS=15

# 启用后从平台领取任务级短期会话，由平台代理调用已配置模型。
AI_ANALYSIS_ENABLED=true
AI_MODEL_ACCESS_MODE=platform
# 与平台使用同一份 security-baseline-review skill；容器路径由 compose 只读挂载。
BUILTIN_SKILL_ROOT=/skills/security-baseline-review
AI_MODEL_CONTEXT_BYTES=120000
# 0 表示扫描筛选后的全部文件；正数仅用于显式限制单任务模型批次。
AI_MODEL_MAX_BATCHES=0
AI_MODEL_TIMEOUT_SECONDS=210

# 仅兼容旧部署：设置 AI_MODEL_ACCESS_MODE=direct 后才需要以下供应商配置。
AI_MODEL_PROTOCOL=responses
AI_MODEL_ENDPOINT=
AI_MODEL_ID=
AI_MODEL_API_KEY=
AI_MODEL_TEMPERATURE=0.1
AI_MODEL_MAX_TOKENS=4096
AI_PROXY_USER_NO=
AI_PROXY_USER_NAME=
AI_PROXY_USER_DEPT_NAME=
