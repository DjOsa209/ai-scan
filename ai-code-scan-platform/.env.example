DOCKER_LIBRARY=public.ecr.aws/docker/library
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
ADMIN_TOKEN=replace-with-a-long-random-token
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
BOOTSTRAP_ADMIN_CREDITS=1000
PUBLIC_API_BASE_URL=http://localhost:8080
PRODUCT_CATALOG_TIMEOUT_SECONDS=15
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn
SSO_AUTH_ENABLED=false
SSO_PROVIDER=uac
SSO_FRONTEND_URL=
SSO_REDIRECT_URI=
SSO_UAC_GATEWAY=
SSO_UAC_APP_ID=
SSO_UAC_LANG=zh
SSO_UAC_SOURCE=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_SCOPE=openid profile email
SSO_USER_ID_FIELD=sub
SSO_USER_NAME_FIELD=name
SSO_USER_EMAIL_FIELD=email
SCAN_QUEUE_PROTOCOL=rabbitmq
SCAN_QUEUE_BROKER_URL=amqp://ai_scan:replace-with-a-rabbitmq-password@rabbitmq:5672/
SCAN_QUEUE_EXCHANGE=security.scan
SCAN_QUEUE_LITE_NAME=security.scan.lite
SCAN_QUEUE_LITE_ROUTING_KEY=security.scan.lite.requested
SCAN_QUEUE_STANDARD_NAME=security.scan.standard
SCAN_QUEUE_STANDARD_ROUTING_KEY=security.scan.standard.requested
SCAN_QUEUE_RELEASE_NAME=security.scan.release
SCAN_QUEUE_RELEASE_ROUTING_KEY=security.scan.release.requested
RABBITMQ_USER=ai_scan
RABBITMQ_PASSWORD=replace-with-a-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_code_scan
MYSQL_USER=ai_code_scan
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
MYSQL_DSN=replace-with-a-complete-mysql-dsn
API_PORT=8080
SKILL_MAX_BYTES=262144
